# Configuración del Servidor de Webhooks OCI
# Copia este archivo a .env y configura tus credenciales

# Configuración SMTP para Gmail
# IMPORTANTE: Debes usar una "Contraseña de Aplicación" de Google, no tu contraseña normal
# Para crear una: https://myaccount.google.com/apppasswords
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_password_de_aplicacion_aqui

# Puerto del servidor (opcional, por defecto 5000)
PORT=5000
