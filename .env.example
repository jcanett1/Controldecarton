# Configuración del Servidor de Webhooks OCI
# Copia este archivo a .env y configura según tu servidor SMTP

# ============================================
# CONFIGURACIÓN PARA SERVIDOR SMTP INTERNO PXG
# ============================================

# Servidor SMTP interno (sin autenticación)
SMTP_SERVER=10.232.237.25
SMTP_PORT=25
SMTP_AUTH_ENABLED=false

# Correo remitente (no requiere contraseña con servidor interno)
FROM_EMAIL=controlcarton@pxg.com

# Puerto del servidor webhook (opcional, por defecto 5000)
PORT=5000

# ============================================
# NOTAS:
# ============================================
# - El servidor SMTP interno PXG (10.232.237.25) no requiere autenticación
# - SMTP_USERNAME y SMTP_PASSWORD no son necesarios
# - Los correos se enviarán desde: controlcarton@pxg.com
# - Los correos llegarán a: jcanett@pxg.com, smexia@pxg.com
# - Si usas otro servidor SMTP (Gmail, Outlook, etc.), cambia:
#   SMTP_SERVER=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_AUTH_ENABLED=true
#   SMTP_USERNAME=tu_correo@gmail.com
#   SMTP_PASSWORD=tu_password_de_aplicacion
